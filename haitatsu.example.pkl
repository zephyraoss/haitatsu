server {
  api_addr = "0.0.0.0:8080"
  public_hostname = "haitatsu.kessoku.zpr.ax"
  instance_name = read("env:HOSTNAME")
  shutdown_timeout_seconds = 10
}

smtp {
  inbound_addr = "0.0.0.0:25"
  max_message_size_bytes = 52428800
  max_inbound_recipients = 100
}

imap {
  addr = "0.0.0.0:143"
  max_connections_per_ip = 30
}

submission {
  starttls_addr = "0.0.0.0:587"
  tls_addr = "0.0.0.0:465"
}

relay {
  addr = "smtp.mailbaby.net:587"
  username = read("env:HAITATSU_RELAY_USERNAME")
  password = read("env:HAITATSU_RELAY_PASSWORD")
  from_host = "smtp.mailbaby.net"
  max_attempts = 30
  max_retry_minutes = 240
}

database {
  driver = read?("env:HAITATSU_DATABASE_DRIVER") ?? "postgres"
  dsn = read?("env:HAITATSU_DATABASE_DSN") ?? read("env:HAITATSU_POSTGRES_DSN")
  auth_token = read?("env:HAITATSU_DATABASE_AUTH_TOKEN") ?? ""
}

s3 {
  endpoint = "100.80.1.1:3900"
  region = "chi-us"
  bucket = "haitatsu"
  access_key_id = read("env:HAITATSU_S3_ACCESS_KEY")
  secret_access_key = read("env:HAITATSU_S3_SECRET_KEY")
  use_ssl = false
}

logging {
  level = "info"
  axiom_enabled = false
  axiom_dataset = "haitatsu"
  axiom_token = read?("env:HAITATSU_AXIOM_TOKEN") ?? ""
  axiom_url = "https://api.axiom.co"
}

metrics {
  enabled = true
}

api {
  service_token = read("env:HAITATSU_SERVICE_TOKEN")
}

workers {
  enabled = true
  concurrency = 4
}

tls {
  mode = "storage"
  cert_file = ""
  key_file = ""
  acme_email = "postmaster@zephyra.email"
  acme_ca = "letsencrypt"
  acme_cache_path = "/var/lib/haitatsu/certmagic"
  acme_listen_host = ""
  acme_http_port = 0
  acme_tls_alpn_port = 0
  acme_disable_http_challenge = true
  acme_disable_tls_alpn_challenge = true
  acme_disable_distributed_solvers = false
  storage {
    endpoint = "100.80.1.1:3900"
    region = "chi-us"
    bucket = "caddy-certs"
    access_key_id = read("env:HAITATSU_CERTS_S3_ACCESS_KEY")
    secret_access_key = read("env:HAITATSU_CERTS_S3_SECRET_KEY")
    use_ssl = false
    prefix = "certmagic"
    issuer = "acme-v02.api.letsencrypt.org-directory"
    hostnames = new Listing<String> { "mx.zephyra.email" }
    refresh_interval_minutes = 60
  }
}

webhooks {
  default_timeout_seconds = 10
  secret = read("env:HAITATSU_WEBHOOK_SECRET")
  endpoints = new Mapping<String, String> {}
  max_attempts = 10
}

notifications {
  from_address = "postmaster@zephyra.email"
  render_url = ""
  render_secret = read("env:HAITATSU_NOTIFICATION_RENDER_SECRET")
  timeout_seconds = 10
  max_response_bytes = 65536
}

spam {
  junk_threshold = 5.0
  reject_threshold = 10.0
  dnsbl_zones = new Listing<String> {}
  dnsbl_score = 4.0
  require_helo = false
}

limits {
  max_message_size_bytes = 52428800
  max_inbound_recipients = 100
  max_submission_recipients = 100
  max_connections_per_ip = 20
  inbound_messages_per_minute_per_ip = 120
  default_outbound_per_hour = 200
  default_outbound_per_day = 2000
  default_outbound_recipients_per_message = 50
}
