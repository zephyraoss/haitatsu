server {
  api_addr = "127.0.0.1:8080"
  public_hostname = "mail.zephyra.cloud"
  instance_name = "dev-email-01"
  shutdown_timeout_seconds = 10
}

smtp {
  inbound_addr = "0.0.0.0:25"
  max_message_size_bytes = 52428800
  max_inbound_recipients = 100
}

imap {
  addr = "0.0.0.0:143"
  max_connections_per_ip = 30
}

submission {
  starttls_addr = "0.0.0.0:587"
  tls_addr = "0.0.0.0:465"
}

relay {
  addr = "smtp.mailbaby.net:587"
  username = ""
  password = ""
  from_host = "smtp.mailbaby.net"
  max_attempts = 30
  max_retry_minutes = 240
}

postgres {
  dsn = "postgres://haitatsu:haitatsu@localhost:5432/haitatsu?sslmode=disable"
}

s3 {
  endpoint = "localhost:9000"
  region = "us-east-1"
  bucket = "haitatsu"
  access_key_id = "minioadmin"
  secret_access_key = "minioadmin"
  use_ssl = false
}

logging {
  level = "info"
  axiom_enabled = false
  axiom_dataset = ""
  axiom_token = ""
  axiom_url = "https://api.axiom.co"
}

metrics {
  enabled = true
}

api {
  service_token = "change-me"
}

workers {
  enabled = true
  concurrency = 4
}

tls {
  mode = "manual"
  cert_file = ""
  key_file = ""
  acme_email = ""
  acme_ca = "letsencrypt"
  acme_cache_path = ""
  acme_listen_host = ""
  acme_http_port = 0
  acme_tls_alpn_port = 0
  acme_disable_http_challenge = false
  acme_disable_tls_alpn_challenge = false
  acme_disable_distributed_solvers = false
}

webhooks {
  default_timeout_seconds = 10
  secret = ""
  endpoints = new Mapping<String, String> {}
  max_attempts = 10
}

notifications {
  from_address = "postmaster@mail.example.com"
  render_url = ""
  render_secret = ""
  timeout_seconds = 10
  max_response_bytes = 65536
}

spam {
  junk_threshold = 5.0
  reject_threshold = 10.0
  dnsbl_zones = new Listing<String> {}
  dnsbl_score = 4.0
  require_helo = false
}

limits {
  max_message_size_bytes = 52428800
  max_inbound_recipients = 100
  max_submission_recipients = 100
  max_connections_per_ip = 20
  inbound_messages_per_minute_per_ip = 120
  default_outbound_per_hour = 200
  default_outbound_per_day = 2000
  default_outbound_recipients_per_message = 50
}
